{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm -C apps/web start",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }]
      }
    }
  }
}
